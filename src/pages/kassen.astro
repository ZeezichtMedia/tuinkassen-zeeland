---
import Basis from '../layouts/Basis.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { bedrijf, eigenKassen, standaard, bijTeKiezen } from '../data/aanbod';
import luchtramen from '../assets/fotos/kassen/compact-230x370-zijkant.webp';
import PaginaKop from '../components/PaginaKop.astro';
import kopfoto from '../assets/fotos/kas-tuin-hortensia.jpg';
import KlikFoto from '../components/KlikFoto.astro';
import KomLangs from '../components/KomLangs.astro';

// Foto's van Wim zelf, per model. De eerste is de grote, de rest staat er klein onder.
import compact1 from '../assets/fotos/kassen/compact-280x370-luchtramen-open.webp';
import compact2 from '../assets/fotos/kassen/compact-230x300-voorkant.webp';
import compact3 from '../assets/fotos/kassen/compact-230x300-zijkant.webp';
import compact4 from '../assets/fotos/kassen/compact-280x370-schuin.webp';
import venlo1 from '../assets/fotos/kassen/venlo-340x585-dubbele-deur-akker.webp';
import venlo2 from '../assets/fotos/kassen/venlo-340x585-dubbele-deur-voorkant.webp';
import venlo3 from '../assets/fotos/kassen/venlo-enkele-deur-kopgevel.webp';
import venlo4 from '../assets/fotos/kassen/venlo-op-muur-zijkant.webp';
import belgisch1 from '../assets/fotos/kassen/belgische-380x510-kopgevel.webp';
import belgisch2 from '../assets/fotos/kassen/belgische-380x510-schuin.webp';
import belgisch3 from '../assets/fotos/kassen/belgische-380x510-zijkant.webp';
import dubbel1 from '../assets/fotos/kassen/dubbelkap-660x600-schuin.webp';
import dubbel2 from '../assets/fotos/kassen/dubbelkap-660x600-kopgevel.webp';
import dubbel3 from '../assets/fotos/kassen/dubbelkap-660x600-goot-detail.webp';
import dubbel4 from '../assets/fotos/kassen/dubbelkap-660x600-zijkant.webp';
import muur1 from '../assets/fotos/kassen/muurkas-maatwerk-bloementuin.webp';
import muur2 from '../assets/fotos/kassen/muurkas-maatwerk-voorkant.webp';
import muur3 from '../assets/fotos/kassen/muurkas-maatwerk-kopgevel.webp';

type Foto = { src: ImageMetadata; alt: string };

const fotos: Record<string, Foto[]> = {
  compact: [
    { src: compact1, alt: 'Compact kas van 2,80 bij 3,70 m in een tuin, met de luchtramen open' },
    { src: compact2, alt: 'Compact kas van 2,30 bij 3,00 m, van voren met de deur' },
    { src: compact3, alt: 'Compact kas van 2,30 bij 3,00 m van opzij, met de luchtramen open' },
    { src: compact4, alt: 'Compact kas van 2,80 bij 3,70 m, schuin van voren' },
  ],
  venlo: [
    { src: venlo1, alt: 'Venlo kas van 3,40 bij 5,85 m met dubbele deur, met een akker erachter' },
    { src: venlo2, alt: 'Venlo kas met dubbele deur, recht van voren met beide deuren open' },
    { src: venlo3, alt: 'Lange Venlo kas met enkele deur, bij een boerderij met een akker erachter' },
    { src: venlo4, alt: 'Venlo kas op een gemetselde muur, van opzij' },
  ],
  belgische: [
    { src: belgisch1, alt: 'Belgische kas van 3,80 bij 5,10 m van voren, met de schuine gevels' },
    { src: belgisch2, alt: 'Belgische kas schuin van voren, met deur en luchtramen' },
    { src: belgisch3, alt: 'Belgische kas van opzij, tegen een groene haag' },
  ],
  dubbelkap: [
    { src: dubbel1, alt: 'Dubbelkap van 6,60 bij 6,00 m, met beide kappen in beeld' },
    { src: dubbel2, alt: 'Dubbelkap van voren, twee puntgevels naast elkaar' },
    { src: dubbel3, alt: 'De goot tussen de twee kappen van een dubbelkap' },
    { src: dubbel4, alt: 'Dubbelkap schuin van opzij, naast een schuur' },
  ],
  maatwerk: [
    { src: muur1, alt: 'Kas op maat tegen een schuur, met een bloementuin ervoor' },
    { src: muur2, alt: 'Kas op maat tegen een schuur, van voren met de deur' },
    { src: muur3, alt: 'Kas op maat tegen een bakstenen muur, de kopgevel' },
  ],
};
---

<Basis
  titel={`Onze kassen | ${bedrijf.naam}`}
  omschrijving="De tuinkassen van Tuinkassen Zeeland: Compact, Venlo kas, Belgische kas, Dubbelkap en maatwerk. Gebouwd van gegalvaniseerd staal en 4 mm tuindersglas."
>
  <PaginaKop
    label="Onze eigen kassen"
    titel="Gegalvaniseerd staal en tuindersglas"
    tekst="Voor onze kassen gebruiken we materiaal uit de kassenbouw: gegalvaniseerd staal en tuindersglas van 4 mm. Daardoor kunnen ze tegen een stootje en gaan ze lang mee. Vier modellen, en verder maken we hem op maat."
    foto={kopfoto}
    altTekst="Tuinkas van Tuinkassen Zeeland in een tuin, met hortensia's ernaast"
  />


  <!-- Snel naar een model -->
  <nav aria-label="Modellen" class="border-y border-staal-200 bg-white">
    <div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-4 sm:px-6">
      <span class="mr-2 hidden shrink-0 self-center text-sm text-staal-500 sm:inline">Ga naar</span>
      {
        eigenKassen.map((k) => (
          <a
            href={`#${k.slug}`}
            class="shrink-0 rounded-full bg-staal-100 px-4 py-2 text-sm font-semibold text-staal-800 transition-colors hover:bg-blad-600 hover:text-white"
          >
            {k.naam}
          </a>
        ))
      }
    </div>
  </nav>

  <!-- Maten -->
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="space-y-16 sm:space-y-24">
        {
          eigenKassen.map((k, i) => {
            const [hoofd, ...rest] = fotos[k.slug];
            return (
            <article
              id={k.slug}
              class="rijs grid scroll-mt-28 items-center gap-8 lg:grid-cols-2 lg:gap-14"
            >
              <div class:list={[i % 2 === 1 && 'lg:order-2']}>
                <KlikFoto
                  src={hoofd.src}
                  alt={hoofd.alt}
                  groep={k.slug}
                  class="h-64 w-full object-cover sm:h-[26rem]"
                  lijst="rounded-2xl"
                  widths={[500, 900]}
                  sizes="(max-width: 1024px) 92vw, 45vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                {/* De andere foto's van hetzelfde model klein eronder, zodat je
                    de kas van meer kanten ziet zonder dat de pagina lang wordt. */}
                <div class="mt-3 grid grid-cols-3 gap-3">
                  {rest.map((f) => (
                    <KlikFoto
                      src={f.src}
                      alt={f.alt}
                      groep={k.slug}
                      class="h-20 w-full object-cover sm:h-28"
                      lijst="rounded-xl"
                      widths={[300, 600]}
                      sizes="(max-width: 1024px) 30vw, 15vw"
                    />
                  ))}
                </div>
              </div>
              <div>
                <p class="oogmerk text-blad-600">{k.type}</p>
                <h2 class="mt-3 text-3xl text-staal-900 sm:text-4xl">{k.naam}</h2>
                <dl class="mt-6 flex gap-10 border-y border-staal-200 py-4">
                  <div>
                    <dt class="text-xs uppercase tracking-wider text-staal-500">Breedte</dt>
                    <dd class="mt-1 font-kop text-2xl text-staal-900">{k.breedte}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wider text-staal-500">Lengte</dt>
                    <dd class="mt-1 font-kop text-2xl text-staal-900">{k.lengte}</dd>
                  </div>
                </dl>
                <p class="mt-6 text-base leading-relaxed text-staal-600">{k.omschrijving}</p>
                <ul class="mt-5 space-y-2.5">
                  {k.kenmerken.map((kenmerk) => (
                    <li class="flex gap-3 text-base text-staal-700">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="mt-1 h-5 w-5 shrink-0 text-blad-600" aria-hidden="true">
                        <path
                          fill-rule="evenodd"
                          d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      <span>{kenmerk}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-5 text-sm leading-relaxed text-staal-500">
                  <span class="font-semibold text-staal-700">Goed voor:</span> {k.voor}
                </p>
                <a
                  href="/contact/"
                  class="mt-7 inline-flex items-center gap-2 font-semibold text-blad-700 transition-colors hover:text-blad-800"
                >
                  Vraag naar deze kas
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </div>
            </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Glas -->
  <section class="vlak-nacht py-16 text-white sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
        <div class="rijs">
          <p class="oogmerk text-blad-300">Het glas</p>
          <h2 class="mt-4 text-3xl text-white sm:text-4xl">Waarom we tuindersglas gebruiken</h2>
          <p class="mt-5 text-base leading-relaxed text-staal-300">
            Bij onze kassen zit glas van tuinderskwaliteit van 4 mm, hetzelfde glas als in de
            kassenbouw. De kas zelf is nieuw, het glas is hergebruikt.
          </p>
        </div>
        <div class="rijs grid gap-x-8 gap-y-6 sm:grid-cols-2">
          <div class="border-t border-white/15 pt-4">
            <h3 class="text-lg text-white">Veel licht</h3>
            <p class="mt-2 text-sm leading-relaxed text-staal-300">
              Glas laat veel licht door, en dat is goed voor je gewassen. Je ziet bovendien van
              buitenaf hoe het ervoor staat in de kas.
            </p>
          </div>
          <div class="border-t border-white/15 pt-4">
            <h3 class="text-lg text-white">Bestand tegen hagel</h3>
            <p class="mt-2 text-sm leading-relaxed text-staal-300">
              Het sterke glas van tuinderskwaliteit houdt een hagelbui gewoon tegen.
            </p>
          </div>
          <div class="border-t border-white/15 pt-4">
            <h3 class="text-lg text-white">Goed schoon te houden</h3>
            <p class="mt-2 text-sm leading-relaxed text-staal-300">
              Door het geharde laagje blijft het glas makkelijk schoon te maken, ook met
              schoonmaakmiddel.
            </p>
          </div>
          <div class="border-t border-white/15 pt-4">
            <h3 class="text-lg text-white">Nieuwe kas, hergebruikt glas</h3>
            <p class="mt-2 text-sm leading-relaxed text-staal-300">
              Het glas is gebruikt tuindersglas. Dat gaat bij jou nog jaren mee, en we werken het
              netjes af met een zwarte strip. Het blijft ook helder: het kan goed tegen krassen en
              tegen weer en wind.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Erbij: wat standaard is en wat je bijkiest -->
  <section class="bg-klei-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs max-w-2xl">
        <p class="oogmerk text-blad-600">Wat er bij hoort</p>
        <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Compleet, zonder waslijst aan opties</h2>
        <p class="mt-5 text-base leading-relaxed text-staal-600">
          We houden het bewust overzichtelijk. Het meeste zit er gewoon bij, en er zijn drie dingen
          die je erbij kunt kiezen. Weet je niet wat je nodig hebt? Bel ons, vertel wat je wilt
          telen en hoe je tuin ligt, dan zeggen wij wel wat zinnig is.
        </p>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rijs rounded-2xl bg-white p-6 sm:col-span-2">
            <h3 class="text-xl text-staal-900">Dit zit er standaard bij</h3>
            <ul class="mt-5 space-y-4">
              {
                standaard.map((a) => (
                  <li class="flex gap-3">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="mt-1 h-5 w-5 shrink-0 text-blad-600" aria-hidden="true">
                      <path
                        fill-rule="evenodd"
                        d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>
                      <span class="block font-semibold text-staal-900">{a.naam}</span>
                      <span class="mt-1 block text-sm leading-relaxed text-staal-600">{a.omschrijving}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            bijTeKiezen.map((a) => (
              <div class="rijs rounded-2xl border border-staal-200 bg-white/60 p-6">
                <h3 class="text-xl text-staal-900">{a.naam}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-staal-600">{a.omschrijving}</p>
              </div>
            ))
          }
          <div class="rijs flex flex-col justify-between rounded-2xl bg-blad-600 p-6 text-white">
            <div>
              <h3 class="text-xl text-white">Iets anders nodig?</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-blad-50">
                Vertel het gewoon. Kan het, dan doen we het, en zo niet dan zeggen we dat ook
                eerlijk.
              </p>
            </div>
            <a href={`tel:${bedrijf.telefoonNet}`} class="mt-6 font-semibold text-white underline underline-offset-4">
              Bel {bedrijf.telefoonToon}
            </a>
          </div>
        </div>

        {/* Beeld vult de hele kolom: met een vaste hoogte bleef er onder de
            foto een leeg vlak staan naast de langere linkerkolom. */}
        <div class="rijs relative min-h-[18rem] overflow-hidden rounded-2xl">
          <Image
            src={luchtramen}
            alt="Compact kas met de luchtramen in het dak open"
            class="absolute inset-0 h-full w-full object-cover"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 92vw, 40vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <KomLangs titel="Kom een kas bekijken" />
</Basis>
