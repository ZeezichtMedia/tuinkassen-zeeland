---
import Basis from '../layouts/Basis.astro';
import { Image } from 'astro:assets';
import { bedrijf } from '../data/aanbod';
import frame from '../assets/fotos/kas-binnen-opbouw.jpg';
import trekker from '../assets/fotos/landbouw-trekker.jpg';
import PaginaKop from '../components/PaginaKop.astro';
import kopfoto from '../assets/fotos/kas-weiland.jpg';
import Uitnodiging from '../components/Uitnodiging.astro';
import KlikFoto from '../components/KlikFoto.astro';
// Uit de galerij van Euroserre, zie src/assets/fotos/euroserre/BRON.md.
import opener from '../assets/fotos/euroserre/raamopener.webp';
import openerDak from '../assets/fotos/euroserre/raamopener-dak.webp';

const diensten = [
  {
    naam: 'Plaatsen',
    tekst:
      'Wij plaatsen je bestelde kas compleet. We hebben er meerdere transportmiddelen voor, dus of hij nu in één keer mee kan of ter plaatse opgebouwd moet worden: het komt goed.',
  },
  {
    naam: 'Nazorg',
    tekst:
      'Wil je na plaatsing nog accessoires aanbrengen, moet een deur nagesteld worden of is er een ruit gebroken? Dan komen we langs. Die service hoort erbij.',
  },
  {
    naam: 'Reparatie',
    tekst:
      'Je kan ook een afspraak maken voor reparatie, ook aan een kas die niet van ons is. Bel wel even van tevoren, dan weet je zeker dat er iemand is.',
  },
  {
    naam: 'Uitbreiding',
    tekst:
      'Een kas te klein geworden? We breiden bestaande kassen uit. Vaak kan er meer dan je denkt.',
  },
  {
    naam: 'Losse onderdelen',
    tekst:
      'Voor losse onderdelen kun je ook bij ons terecht. Automatische raamopeners verkopen we bijvoorbeeld veel los, en een ruit maken we op maat.',
  },
];
---

<Basis
  titel={`Service en reparatie | ${bedrijf.naam}`}
  omschrijving="Plaatsen, nazorg, reparatie, uitbreiding en losse onderdelen voor tuinkassen. Ook voor bestaande kassen. Tuinkassen Zeeland, Ritthem."
>
  <PaginaKop
    label="Service"
    titel="Ook na de bouw kun je ons bellen"
    tekst="We doen er alles aan om de verwachtingen van onze klanten te overtreffen. Het is niet voor niets dat de meeste van onze klanten steeds weer bij ons terugkomen."
    foto={kopfoto}
    altTekst="Tuinkas op een ruim perceel, met moestuinbakken ernaast"
  />

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="rijs">
          <Image
            src={frame}
            alt="Kas in aanbouw, met de constructie nog open"
            class="h-72 w-full rounded-2xl object-cover sm:h-[30rem]"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 92vw, 45vw"
          />
        </div>
        <div class="space-y-9">
          {
            diensten.map((d, i) => (
              <div class="rijs flex gap-5">
                <span class="font-kop text-3xl font-light text-blad-500 tabular-nums">
                  0{i + 1}
                </span>
                <div class="border-t border-staal-200 pt-3">
                  <h2 class="text-2xl text-staal-900">{d.naam}</h2>
                  <p class="mt-2.5 text-base leading-relaxed text-staal-600">{d.tekst}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>


  <!-- Losse onderdelen: de raamopeners gaan hard -->
  <section class="bg-white pb-16 sm:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs grid items-center gap-8 overflow-hidden rounded-[1.75rem] bg-klei-50 p-6 ring-1 ring-staal-900/5 sm:p-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
        <div>
          <p class="oogmerk text-blad-600">Losse onderdelen</p>
          <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Automatische raamopeners</h2>
          <p class="mt-5 leading-relaxed text-staal-600">
            Een raamopener zet het luchtraam vanzelf open als het warm wordt, en doet het weer dicht
            als het afkoelt. Geen stroom nodig, en je hoeft er niet voor thuis te zijn. Die verkopen we
            ook los, net als ruiten op maat en andere onderdelen. Bel even, dan kijken we wat er op
            jouw kas past.
          </p>
          <a href={`tel:${bedrijf.telefoonNet}`} class="knop-vol mt-8 justify-center">Bel {bedrijf.telefoonToon}</a>
        </div>
        <div class="grid grid-cols-[1.6fr_1fr] gap-3">
          <KlikFoto
            src={opener}
            alt="Een automatische raamopener aan een luchtraam van een kas"
            groep="onderdelen"
            class="h-56 w-full object-cover sm:h-72"
            lijst="rounded-2xl"
            sizes="(max-width: 1024px) 56vw, 30vw"
          />
          <KlikFoto
            src={openerDak}
            alt="Openstaande luchtramen met raamopeners, van binnen gezien"
            groep="onderdelen"
            class="h-56 w-full object-cover sm:h-72"
            lijst="rounded-2xl"
            sizes="(max-width: 1024px) 34vw, 18vw"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Over het bedrijf -->
  <section class="bg-klei-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="rijs lg:order-2">
          <Image
            src={trekker}
            alt="Trekker met kipper van Landbouwbedrijf Markusse tijdens de bietenoogst"
            class="h-72 w-full rounded-2xl object-cover sm:h-96"
            widths={[400, 684]}
            sizes="(max-width: 1024px) 92vw, 45vw"
          />
        </div>
        <div class="rijs">
          <p class="oogmerk text-blad-600">Over ons</p>
          <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">
            Kassen bouwen we naast het boerenwerk
          </h2>
          <div class="mt-6 space-y-4 text-base leading-relaxed text-staal-600">
            <p>
              {bedrijf.moeder} houdt zich bezig met het bouwen en leveren van tuinkassen, naast het
              telen van granen, peulvruchten, oliehoudende zaden, aardappels, suikerbieten en
              overige wortel- en knolgewassen.
            </p>
            <p>
              We staan dus zelf ook op het land. Daarom bouwen we de kassen van gegalvaniseerd
              staal met 4 mm tuindersglas. Zo gaan ze hier gewoon lang mee.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Uitnodiging
    label="Service"
    titel="Iets kapot, of moet er iets bij?"
    tekst="Bel ons even, dan maken we een afspraak. Ook als je kas niet van ons is. Het glas maken we zelf op maat."
    foto={frame}
    altTekst="Kas in aanbouw, met de constructie nog open"
  />
</Basis>
