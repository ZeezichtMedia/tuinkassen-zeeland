---
import Basis from '../layouts/Basis.astro';
import { bedrijf, euroSerres, kleuren, bestsellerJaar } from '../data/aanbod';
import SerreTekening from '../components/SerreTekening.astro';
import KomLangs from '../components/KomLangs.astro';

/* Geen foto's van Euroserre op deze pagina. In 2026 vroeg Euroserre de
   verdelers om alle beelden van fotograaf Herbert Bleijenberg te verwijderen;
   een extern kantoor (Pixsy) spoort ze op en stuurt meteen een rekening. We
   weten van geen enkele foto van hun site zeker onder welke licentie hij valt,
   dus we tonen er geen en tekenen de modellen zelf (SerreTekening.astro).
   Foto's kunnen er later weer bij, maar alleen: van serres die Wim zelf heeft
   gezet, of uit de verdelersgalerij van Euroserre met een lopende licentie. */

const bestsellers = euroSerres.filter((s) => s.bestseller);
const tekeningPer: Record<string, { model: 'maxi' | 'rustiq' | 'plus' | 'muur'; kleur: string }> = {
  'euro-maxi': { model: 'maxi', kleur: '#1b1b1b' },
  'euro-rustiq': { model: 'rustiq', kleur: '#27352a' },
  'euro-plus': { model: 'plus', kleur: '#8f9592' },
  'euro-muurserre': { model: 'muur', kleur: '#1b1b1b' },
};

const vrijstaand = euroSerres.filter((s) => s.categorie === 'Vrijstaand');
const muur = euroSerres.filter((s) => s.categorie === 'Tegen een muur');

const stappen = [
  { kop: 'Teken je serre', tekst: 'Kies model, maat, kleur en opties. Dat gaat het best op een computer.' },
  { kop: 'Maak een foto van je tekening', tekst: 'Een schermafbeelding is prima, of een foto met je telefoon.' },
  { kop: `App hem naar ${bedrijf.telefoonToon}`, tekst: 'Wij bellen je terug met een prijs en een datum.' },
];
---

<Basis
  titel={`Euroserre aluminium serres | ${bedrijf.naam}`}
  omschrijving="Wij leveren en plaatsen de aluminium serres van Euroserre in Zeeland. Standaard in zwart, donkergroen of aluminium, met 4 mm veiligheidsglas. Kom kijken in Ritthem."
>
  <!-- Kop: een getekende serre die je zelf een kleur geeft -->
  <section class="relative overflow-hidden bg-klei-50 pt-28 sm:pt-36">
    <div
      class="pointer-events-none absolute -left-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-[radial-gradient(circle,rgba(30,109,19,0.10),transparent_65%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-4 pb-16 sm:px-6 sm:pb-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div>
          <p class="oogmerk flex items-center gap-2.5 text-blad-700">
            <span class="h-3 w-1 rounded-full bg-blad-600" aria-hidden="true"></span>
            Euroserre bij ons
          </p>
          <h1 class="display mt-5 text-staal-900">Een serre in jouw kleur, met veiligheidsglas</h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-staal-600 sm:text-lg">
            Wil je geen grijze kas maar een serre in het zwart of donkergroen, met veiligheidsglas
            erin? Dan zit je bij Euroserre goed. Wij leveren ze in Zeeland, en zetten hem ook voor je
            neer.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="#langskomen" class="knop-vol justify-center">Kom kijken in Ritthem</a>
            <a
              href="#bestsellers"
              class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-staal-300 px-6 py-3.5 font-semibold text-staal-800 transition-colors hover:border-staal-400 hover:bg-white"
            >
              Bekijk de bestsellers
            </a>
          </div>
        </div>

        <div class="rounded-[1.75rem] bg-[linear-gradient(180deg,#eef3ec_0%,#e2eadf_100%)] p-6 shadow-[0_30px_80px_-50px_rgba(14,26,15,0.5)] sm:p-9" data-kleurkiezer>
          <SerreTekening model="rustiq" kleur={kleuren[0].hex} class="w-full" titel="Tekening van een serre in de gekozen kleur" />
          <div class="mt-4 flex flex-wrap items-center justify-between gap-4 border-t border-staal-900/10 pt-5">
            <div role="group" aria-label="Kies een kleur voor het frame" class="flex gap-2.5">
              {
                kleuren.map((k, i) => (
                  <button
                    type="button"
                    data-kleur={k.hex}
                    data-naam={k.naam}
                    data-info={`${k.ral}${k.standaard ? ', standaard' : ', tegen meerprijs'}`}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={`${k.naam}, ${k.ral}`}
                    class="kleur-knop h-10 w-10 rounded-full ring-1 ring-inset ring-staal-900/20"
                    style={`background:${k.hex}`}
                  />
                ))
              }
            </div>
            <p class="text-sm leading-tight text-staal-600" aria-live="polite">
              <span class="block font-semibold text-staal-900" data-kleurnaam>{kleuren[0].naam}</span>
              <span data-kleurinfo>{kleuren[0].ral}, standaard</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bestsellers: de lijst die Euroserre zelf voert, jaarlijks te verversen -->
  <section id="bestsellers" class="scroll-mt-24 bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="oogmerk text-blad-600">Bestsellers {bestsellerJaar}</p>
          <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Deze vier gaan het hardst</h2>
          <p class="mt-4 leading-relaxed text-staal-600">
            Dit zijn de modellen die Euroserre zelf als bestseller voert. Wil je er eentje in het
            echt zien? Bel even, dan kijken we of er een bij ons in Ritthem staat.
          </p>
        </div>
        <a href="#modellen" class="shrink-0 font-semibold text-blad-700 hover:text-blad-800">
          Naar alle modellen
        </a>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          bestsellers.map((s) => (
            <article class="rijs group flex flex-col overflow-hidden rounded-2xl bg-klei-50 ring-1 ring-staal-900/5 transition-shadow duration-300 hover:shadow-[0_24px_50px_-30px_rgba(14,26,15,0.45)]">
              <div class="relative bg-[linear-gradient(180deg,#eef3ec_0%,#e2eadf_100%)] px-4 pb-2 pt-8">
                <SerreTekening
                  model={tekeningPer[s.slug].model}
                  kleur={tekeningPer[s.slug].kleur}
                  class="w-full transition-transform duration-500 group-hover:scale-[1.03]"
                />
                <span class="absolute left-3 top-3 rounded-full bg-blad-600 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-white">
                  Bestseller
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-2xl text-staal-900">{s.naam}</h3>
                {s.typering && <p class="mt-1 text-sm text-blad-700">{s.typering}</p>}
                <p class="mt-2 flex-1 text-sm leading-relaxed text-staal-600">{s.omschrijving}</p>
                <dl class="mt-4 space-y-1.5 border-t border-staal-900/10 pt-3 text-sm">
                  <div class="flex justify-between gap-3">
                    <dt class="text-staal-500">Breedte</dt>
                    <dd class="text-right font-semibold text-staal-900">{s.breedte}</dd>
                  </div>
                  <div class="flex justify-between gap-3">
                    <dt class="text-staal-500">Lengte</dt>
                    <dd class="text-right font-semibold text-staal-900">{s.lengtes}</dd>
                  </div>
                  <div class="flex justify-between gap-3">
                    <dt class="text-staal-500">Nokhoogte</dt>
                    <dd class="text-right font-semibold text-staal-900">{s.nokhoogte}</dd>
                  </div>
                </dl>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-5 text-xs text-staal-500">
        Tekeningen ter indruk. Hoe jouw serre er precies uitziet, laten we je graag in het echt zien.
      </p>
    </div>
  </section>

  <!-- Kleur en glas -->
  <section class="vlak-nacht py-16 text-white sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div class="rijs">
          <p class="oogmerk text-blad-300">Kleur en glas</p>
          <h2 class="mt-4 text-3xl text-white sm:text-4xl">Niet iedereen wil nog een grijze kas</h2>
          <p class="mt-5 leading-relaxed text-staal-300">
            Ongeveer de helft van de mensen die hier binnenloopt, wil zijn kas in een kleur. Zwart of
            een diep groen, zodat hij wegvalt tegen de tuin. Bij Euroserre kies je standaard uit
            onbehandeld aluminium, zwart of donkergroen. Elke andere RAL-kleur kan ook, maar die
            wordt dan speciaal voor je gelakt en dat kost meer. Wat precies, dat rekenen we vooraf
            met je door.
          </p>
          <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-5">
            {
              kleuren.map((k) => (
                <li class="flex items-center gap-3">
                  <span class="h-9 w-9 shrink-0 rounded-full ring-1 ring-inset ring-white/45" style={`background:${k.hex}`} aria-hidden="true" />
                  <span class="text-sm leading-tight">
                    <span class="block font-semibold text-white">{k.naam}</span>
                    <span class="block text-staal-300">
                      {k.ral}
                      {!k.standaard && ' · meerprijs'}
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rijs rounded-2xl border border-white/12 bg-white/5 p-7 sm:p-9">
          <h3 class="text-2xl text-white">Standaard veiligheidsglas</h3>
          <p class="mt-4 leading-relaxed text-staal-300">
            Elke Euroserre komt met 4 mm gehard veiligheidsglas. Als het toch een keer breekt, valt
            het uit elkaar in kleine, stompe korrels in plaats van scherven. Dat scheelt, zeker als
            er kinderen in de tuin spelen.
          </p>
          <p class="mt-4 leading-relaxed text-staal-300">
            In onze eigen stalen kassen zit 4 mm tuindersglas, hetzelfde glas als in de kassenbouw.
            Wil je liever veiligheidsglas, dan is een Euroserre de makkelijkste route.
          </p>
          <a href="/kassen/" class="mt-6 inline-flex items-center gap-2 font-semibold text-blad-300 transition-colors hover:text-blad-200">
            Vergelijk met onze stalen kassen
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Het tekenprogramma van Euroserre -->
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs overflow-hidden rounded-[1.75rem] ring-1 ring-staal-900/8">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr]">
          <div class="p-7 sm:p-10 lg:p-12">
            <p class="oogmerk text-blad-600">Het tekenprogramma</p>
            <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Zie je serre voor je? Teken hem zelf</h2>
            <p class="mt-5 leading-relaxed text-staal-600">
              Euroserre heeft een tekenprogramma waarin je je serre helemaal zelf samenstelt: model,
              maat, kleur en opties. Je ziet meteen hoe hij eruit komt te zien.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a href={bedrijf.euroserreConfigurator} target="_blank" rel="noopener" class="knop-vol justify-center">
                Open het tekenprogramma
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
                  <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
                </svg>
              </a>
            </div>
            <p class="mt-5 text-sm text-staal-500">
              Kom je er niet uit? Kom langs in Ritthem, dan tekenen we hem samen.
            </p>
          </div>
          <div class="bg-blad-600 p-7 text-white sm:p-10 lg:p-12">
            <p class="oogmerk text-blad-100">Zo komt je tekening bij ons</p>
            <ol class="mt-6 space-y-6">
              {
                stappen.map((s, i) => (
                  <li class="flex gap-4">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15 font-kop text-lg">{i + 1}</span>
                    <span>
                      <span class="block text-lg font-semibold">{s.kop}</span>
                      <span class="mt-1 block text-sm leading-relaxed text-blad-50">{s.tekst}</span>
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alle modellen: rustig overzicht, gegroepeerd -->
  <section id="modellen" class="scroll-mt-24 bg-klei-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs max-w-2xl">
        <p class="oogmerk text-blad-600">Alle modellen</p>
        <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Vrijstaand of tegen een muur</h2>
        <p class="mt-4 leading-relaxed text-staal-600">
          Naast de bestsellers kunnen we de hele reeks van Euroserre leveren. Welke het beste bij jouw
          tuin past, bespreken we graag aan de keukentafel.
        </p>
      </div>

      {
        [
          { titel: 'Vrijstaand', lijst: vrijstaand, model: 'maxi' as const },
          { titel: 'Tegen een muur', lijst: muur, model: 'muur' as const },
        ].map((groep) => (
          <div class="mt-12">
            <div class="rijs flex items-center gap-4">
              <SerreTekening model={groep.model} kleur="#1e6d13" class="h-12 w-auto" />
              <h3 class="text-2xl text-staal-900">
                {groep.titel} <span class="text-base text-staal-500">({groep.lijst.length})</span>
              </h3>
            </div>
            <div
              class:list={[
                'mt-5 grid gap-px overflow-hidden rounded-2xl bg-staal-900/8 ring-1 ring-staal-900/8 sm:grid-cols-2',
                groep.lijst.length % 3 === 0 ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
              ]}
            >
              {groep.lijst.map((s) => (
                <article class="rijs flex flex-col bg-white p-6">
                  <div class="flex items-baseline justify-between gap-3">
                    <h4 class="text-xl text-staal-900">{s.naam}</h4>
                    {s.bestseller && (
                      <span class="shrink-0 rounded-full bg-blad-50 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-blad-700">
                        Bestseller
                      </span>
                    )}
                  </div>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-staal-600">{s.omschrijving}</p>
                  <p class="mt-4 text-sm text-staal-500">
                    <span class="font-semibold text-staal-800">{s.breedte}</span> breed, vanaf{' '}
                    <span class="font-semibold text-staal-800">{s.minLengte}</span> lang
                  </p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Zelfbouw of plaatsen -->
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs max-w-xl">
        <p class="oogmerk text-blad-600">Twee manieren</p>
        <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Zelf bouwen of door ons laten zetten</h2>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <div class="rijs rounded-2xl bg-klei-50 p-7 sm:p-9">
          <h3 class="text-2xl text-staal-900">Zelfbouwpakket</h3>
          <p class="mt-3 leading-relaxed text-staal-600">
            Je krijgt de serre compleet aangeleverd met een handleiding, en zet hem zelf in elkaar.
            Handig als je graag klust.
          </p>
        </div>
        <div class="rijs rounded-2xl bg-blad-600 p-7 text-white sm:p-9">
          <h3 class="text-2xl text-white">Wij plaatsen hem</h3>
          <p class="mt-3 leading-relaxed text-blad-50">
            Wij zetten je serre neer, net als onze eigen kassen. Met fundering en afvoer als je dat
            wilt. Je hoeft er zelf niets voor te doen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <KomLangs />
</Basis>

<style>
  .kleur-knop {
    transition: transform 0.18s var(--ease-uit), box-shadow 0.2s ease;
  }
  .kleur-knop:hover {
    transform: scale(1.08);
  }
  .kleur-knop[aria-pressed='true'] {
    box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--color-blad-600);
  }
</style>

<script>
  // De kleurknoppen kleuren de getekende serre live mee.
  document.querySelectorAll<HTMLElement>('[data-kleurkiezer]').forEach((kiezer) => {
    const tekening = kiezer.querySelector<SVGElement>('.serre-tekening');
    const naam = kiezer.querySelector('[data-kleurnaam]');
    const info = kiezer.querySelector('[data-kleurinfo]');
    const knoppen = [...kiezer.querySelectorAll<HTMLButtonElement>('[data-kleur]')];
    knoppen.forEach((knop) =>
      knop.addEventListener('click', () => {
        tekening?.style.setProperty('--frame', knop.dataset.kleur ?? '');
        knoppen.forEach((k) => k.setAttribute('aria-pressed', String(k === knop)));
        if (naam) naam.textContent = knop.dataset.naam ?? '';
        if (info) info.textContent = knop.dataset.info ?? '';
      })
    );
  });
</script>
