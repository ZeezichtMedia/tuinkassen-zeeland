---
import Basis from '../layouts/Basis.astro';
import { bedrijf, euroSerres, kleuren, bestsellerJaar } from '../data/aanbod';
import PaginaKop from '../components/PaginaKop.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import fotoAvond from '../assets/fotos/euroserre-tuin-avond.webp';
import fotoRozen from '../assets/fotos/euroserre-rozen-bank.webp';
import fotoModern from '../assets/fotos/euroserre-modern-lounge.webp';
import fotoVictorian from '../assets/fotos/euroserre-victorian-terras.webp';
import fotoBaksteen from '../assets/fotos/euroserre-bakstenen-voet.webp';
import fotoKinderen from '../assets/fotos/euroserre-kinderen.webp';
import fotoMuur from '../assets/fotos/euroserre-muurserre.webp';

// Productfoto's bij een greep uit de modellen. Bewust niet bij alle 16: dit is
// de eerste demo, dit geeft alvast een beeld van wat er mogelijk is.
import modelMaxi from '../assets/fotos/euroserre-model-maxi.webp';
import modelRustiq from '../assets/fotos/euroserre-model-rustiq.webp';
import modelCottage from '../assets/fotos/euroserre-model-cottage.webp';
import modelPlus from '../assets/fotos/euroserre-model-plus.webp';
import modelMuurserre from '../assets/fotos/euroserre-model-muurserre.webp';

const modelFotos: Record<string, ImageMetadata> = {
  'euro-maxi': modelMaxi,
  'euro-rustiq': modelRustiq,
  'euro-cottage': modelCottage,
  'euro-plus': modelPlus,
  'euro-muurserre': modelMuurserre,
};

// Voor deze eerste demo tonen we alleen de modellen waar we een foto bij hebben.
const getoondeSerres = euroSerres.filter((s) => modelFotos[s.slug]);
const bestsellers = euroSerres.filter((s) => s.bestseller);

const categorieen = ['Alles', 'Vrijstaand', 'Tegen een muur'];


/* Foto's van Euroserre zelf, zodat we hun modellen met hun eigen beeld laten
   zien (en niet met onze stalen kassen, dat zou juist verwarrend zijn). */
const galerij = [
  {
    src: fotoRozen,
    alt: 'Een klassieke serre in een tuin met roze rozen ervoor en een wit bankje.',
    tekst: 'De klassieke serre tussen de rozen, met een bankje om even te zitten.',
  },
  {
    src: fotoModern,
    alt: 'Een strakke moderne zwarte serre met een loungehoek ernaast.',
    tekst: 'Een strak, modern model met een loungehoek er vlak naast.',
  },
  {
    src: fotoVictorian,
    alt: 'Een ruime groene serre met een terras en stoelen ervoor.',
    tekst: 'Een ruime serre met terras, net zo goed een tuinkamer om in te zitten.',
  },
  {
    src: fotoBaksteen,
    alt: 'Een serre op een gemetselde bakstenen voet in de tuin.',
    tekst: 'Op een gemetselde voet, mooi weggewerkt in de tuin.',
  },
  {
    src: fotoAvond,
    alt: 'Een serre op een gemetselde voet in een bloeiende tuin, in de zon.',
    tekst: 'Midden in een bloeiende tuin, op een gemetselde voet.',
  },
  {
    src: fotoMuur,
    alt: 'Een muurserre die tegen de gevel van een huis aan is gebouwd.',
    tekst: 'Een muurserre tegen het huis, zo aangesloten op water en stroom.',
  },
];
---

<Basis
  titel={`Euroserre aluminium serres | ${bedrijf.naam}`}
  omschrijving="Wij zijn leverancier van Euroserre. Aluminium serres in elke RAL-kleur, met 4 mm veiligheidsglas. Van de Euro-Micro tot de Euro-Super, geleverd en geplaatst vanuit Ritthem."
>
  {/* Beeld van Euroserre zelf: het zijn hun modellen, dus hun eigen foto's
      horen erbij. Bovenaan bewust een gewone serre op de grond en geen luxe
      exemplaar op een gemetselde voet: Wim wil niet dat mensen bij binnenkomst
      denken dat het te duur voor ze is. De luxere foto's staan verderop. */}
  <PaginaKop
    label="Euroserre bij ons"
    titel="Een serre in jouw kleur, met veiligheidsglas"
    tekst="Wil je geen grijze kas maar een serre in het zwart of donkergroen, en het liefst met veiligheidsglas erin? Dan zit je bij Euroserre goed. Wij zijn hun leverancier in Zeeland: je koopt de serre bij ons, en wij zetten hem ook neer."
    foto={fotoKinderen}
    altTekst="Een groene aluminium serre van Euroserre in een tuin, met twee kinderen tussen de opgekweekte plantjes."
  />

  <!-- Bestsellers: de lijst die Euroserre zelf voert, jaarlijks te verversen -->
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="oogmerk text-blad-600">Bestsellers {bestsellerJaar}</p>
          <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">
            Deze vier gaan het hardst
          </h2>
          <p class="mt-4 leading-relaxed text-staal-600">
            Dit zijn de modellen die Euroserre zelf als bestseller voert, en die wij hier het
            vaakst neerzetten. Er staat er ook regelmatig eentje bij ons in de showroom, dus je
            kan er gewoon even naast gaan staan.
          </p>
        </div>
        <a href="#modellen" class="shrink-0 font-semibold text-blad-700 hover:text-blad-800">
          Naar alle modellen
        </a>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          bestsellers.map((s, i) => (
            <article class="rijs flex flex-col overflow-hidden rounded-2xl bg-klei-50 shadow-[0_1px_3px_rgba(14,26,15,0.08)]">
              <div class="relative">
                <Image
                  src={modelFotos[s.slug]}
                  alt={`De ${s.naam} van Euroserre, opgesteld in een tuin.`}
                  class="h-44 w-full object-cover"
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 23vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
                <span class="absolute left-3 top-3 rounded-full bg-blad-600 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-white">
                  Bestseller
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-2xl text-staal-900">{s.naam}</h3>
                {s.typering && <p class="mt-1 text-sm text-blad-700">{s.typering}</p>}
                <p class="mt-2 flex-1 text-sm leading-relaxed text-staal-600">{s.omschrijving}</p>
                <dl class="mt-4 space-y-1.5 border-t border-staal-900/10 pt-3 text-sm">
                  <div class="flex justify-between gap-3">
                    <dt class="text-staal-500">Breedte</dt>
                    <dd class="text-right font-semibold text-staal-900">{s.breedte}</dd>
                  </div>
                  <div class="flex justify-between gap-3">
                    <dt class="text-staal-500">Lengte</dt>
                    <dd class="text-right font-semibold text-staal-900">{s.lengtes}</dd>
                  </div>
                  <div class="flex justify-between gap-3">
                    <dt class="text-staal-500">Nokhoogte</dt>
                    <dd class="text-right font-semibold text-staal-900">{s.nokhoogte}</dd>
                  </div>
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Kleur en glas: precies waar mensen om vragen -->
  <section class="vlak-nacht py-16 text-white sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div class="rijs">
          <p class="oogmerk text-blad-300">Kleur en glas</p>
          <h2 class="mt-4 text-3xl text-white sm:text-4xl">
            Niet iedereen wil nog een grijze kas
          </h2>
          <p class="mt-5 leading-relaxed text-staal-300">
            Ongeveer de helft van de mensen die hier binnenloopt, wil zijn kas in een kleur. Zwart of
            een diep groen, zodat hij wegvalt tegen de tuin. Bij Euroserre kies je standaard uit
            onbehandeld aluminium, zwart of donkergroen. Elke andere RAL-kleur kan ook, maar die
            wordt dan speciaal voor je gelakt en dat kost meer. Wat precies, dat rekenen we vooraf
            met je door.
          </p>

          <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-5">
            {
              kleuren.map((k) => (
                <li class="flex items-center gap-3">
                  {/* Ring om elke swatch: zonder rand valt zwart weg tegen
                      het donkergroene vlak. */}
                  <span
                    class="h-9 w-9 shrink-0 rounded-full ring-1 ring-inset ring-white/45"
                    style={`background:${k.hex}`}
                    aria-hidden="true"
                  />
                  <span class="text-sm leading-tight">
                    <span class="block font-semibold text-white">{k.naam}</span>
                    <span class="block text-staal-300">
                      {k.ral}
                      {!k.standaard && ' · meerprijs'}
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rijs rounded-2xl border border-white/12 bg-white/5 p-7 sm:p-9">
          <h3 class="text-2xl text-white">Standaard veiligheidsglas</h3>
          <p class="mt-4 leading-relaxed text-staal-300">
            Elke Euroserre komt met 4 mm gehard veiligheidsglas. Dat laat zo'n 90 procent van het
            licht door, en als het toch een keer breekt, valt het uit elkaar in kleine, stompe
            korrels in plaats van scherven. Dat scheelt, zeker als er kinderen in de tuin spelen.
          </p>
          <p class="mt-4 leading-relaxed text-staal-300">
            Wij zetten in onze eigen stalen kassen 4 mm tuindersglas, hetzelfde glas als in de
            professionele kassenbouw. Wil je liever veiligheidsglas, dan is een Euroserre de
            makkelijkste route.
          </p>
          <a
            href="/kassen/"
            class="mt-6 inline-flex items-center gap-2 font-semibold text-blad-300 transition-colors hover:text-blad-200"
          >
            Vergelijk met onze stalen kassen
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Teken je eigen serre bij Euroserre -->
  <section class="bg-klei-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs overflow-hidden rounded-2xl bg-white shadow-[0_1px_3px_rgba(14,26,15,0.08)]">
        <div class="grid gap-0 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="p-7 sm:p-10">
            <p class="oogmerk text-blad-600">Het tekenprogramma</p>
            <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">
              Zie je serre voor je? Teken hem zelf
            </h2>
            <p class="mt-5 leading-relaxed text-staal-600">
              Euroserre heeft een tekenprogramma waarin je je serre helemaal zelf samenstelt: model,
              maat, kleur en opties. Je ziet meteen hoe hij eruit komt te zien. Klaar? Maak een foto
              of schermafbeelding van je tekening en app die naar {bedrijf.telefoonToon}. Dan bellen
              wij je met een prijs en een datum.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a
                href={bedrijf.euroserreConfigurator}
                target="_blank"
                rel="noopener"
                class="knop-vol justify-center"
              >
                Open het tekenprogramma
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path
                    d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
                  ></path>
                  <path
                    d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
                  ></path>
                </svg>
              </a>
              <a href="/contact/" class="font-semibold text-blad-700 hover:text-blad-800">
                Liever samen doorlopen? Bel ons
              </a>
            </div>
            <p class="mt-5 text-sm text-staal-500">
              Het tekenprogramma werkt het best op een computer. Kom je er niet uit? Kom langs in
              Ritthem, dan tekenen we hem samen.
            </p>
          </div>
          <div class="relative min-h-[16rem]">
            <Image
              src={fotoModern}
              alt="Een strakke moderne zwarte serre met een loungehoek ernaast."
              class="absolute inset-0 h-full w-full object-cover"
              widths={[400, 900]}
              sizes="(max-width: 1024px) 92vw, 40vw"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fotogalerij: Euroserre-serres zoals ze er in het echt bij staan -->
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs max-w-2xl">
        <p class="oogmerk text-blad-600">In het echt</p>
        <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Zo staan ze straks bij de mensen in de tuin</h2>
        <p class="mt-4 leading-relaxed text-staal-600">
          Een paar voorbeelden van serres van Euroserre, zoals ze er in het echt bij staan. Van een
          strak modern model tot een klassieke serre tussen de rozen, er is er altijd wel eentje die
          bij jouw tuin past.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          galerij.map((f) => (
            <figure class="rijs overflow-hidden rounded-2xl bg-klei-50 shadow-[0_1px_3px_rgba(14,26,15,0.08)]">
              <Image
                src={f.src}
                alt={f.alt}
                class="h-64 w-full object-cover sm:h-72"
                widths={[400, 800]}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
                loading="lazy"
              />
              <figcaption class="px-5 py-4 text-sm leading-relaxed text-staal-600">{f.tekst}</figcaption>
            </figure>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-staal-500">Foto's: Euroserre.</p>
    </div>
  </section>

  <!-- Filter en modellen -->
  <section id="modellen" class="scroll-mt-28 bg-white pb-14 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs mb-8 max-w-2xl">
        <p class="oogmerk text-blad-600">Alle modellen</p>
        <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Vrijstaand of tegen een muur</h2>
      </div>

      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter op type serre">
        {
          categorieen.map((c, i) => (
            <button
              type="button"
              data-filter={c}
              class:list={[
                'rounded-full px-5 py-2.5 text-sm font-semibold transition-colors',
                i === 0
                  ? 'bg-blad-600 text-white'
                  : 'bg-staal-100 text-staal-700 hover:bg-staal-200',
              ]}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {c}
            </button>
          ))
        }
        <p class="ml-auto text-sm text-staal-500" data-telling>
          {getoondeSerres.length} modellen
        </p>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          getoondeSerres.map((s) => {
            const foto = modelFotos[s.slug];
            return (
              <article
                data-serre
                data-categorie={s.categorie}
                class="rijs flex flex-col overflow-hidden rounded-2xl bg-klei-50 transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-1 hover:shadow-[0_20px_44px_-22px_rgba(14,26,15,0.4)]"
              >
                {foto && (
                  <Image
                    src={foto}
                    alt={`De ${s.naam} van Euroserre, opgesteld in een tuin.`}
                    class="h-48 w-full object-cover"
                    widths={[400, 800]}
                    sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
                    loading="lazy"
                  />
                )}
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-2xl text-staal-900">{s.naam}</h3>
                    <span class="shrink-0 rounded-full bg-blad-50 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-blad-700">
                      {s.categorie}
                    </span>
                  </div>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-staal-600">{s.omschrijving}</p>
                  <dl class="mt-5 flex gap-8 border-t border-staal-900/10 pt-4 text-sm">
                    <div>
                      <dt class="text-staal-500">Breedte</dt>
                      <dd class="mt-0.5 font-semibold text-staal-900">{s.breedte}</dd>
                    </div>
                    <div>
                      <dt class="text-staal-500">Vanaf lengte</dt>
                      <dd class="mt-0.5 font-semibold text-staal-900">{s.minLengte}</dd>
                    </div>
                  </dl>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Zelfbouw of plaatsen -->
  <section class="bg-klei-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs max-w-xl">
        <p class="oogmerk text-blad-600">Twee manieren</p>
        <h2 class="mt-4 text-3xl text-staal-900 sm:text-4xl">Zelf bouwen of door ons laten zetten</h2>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <div class="rijs rounded-2xl bg-white p-7">
          <h3 class="text-2xl text-staal-900">Zelfbouwpakket</h3>
          <p class="mt-3 text-sm leading-relaxed text-staal-600">
            Je krijgt de serre compleet aangeleverd met een handleiding, en zet hem zelf in elkaar.
            Handig als je graag klust en het budget scherp wilt houden.
          </p>
        </div>
        <div class="rijs rounded-2xl bg-blad-600 p-7 text-white">
          <h3 class="text-2xl text-white">Wij plaatsen hem</h3>
          <p class="mt-3 text-sm leading-relaxed text-blad-50">
            Wij zetten je serre vakkundig neer, net als onze eigen kassen. Inclusief fundering en
            afvoer als je dat wilt. Je hoeft er zelf niets voor te doen.
          </p>
        </div>
      </div>

      <div class="rijs mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="knop-vol justify-center">Kom langs of stuur een bericht</a>
        <a
          href={`tel:${bedrijf.telefoonNet}`}
          class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-staal-300 px-6 py-3.5 font-semibold text-staal-800 transition-colors hover:bg-staal-100"
        >
          Bel {bedrijf.telefoonToon} voor advies
        </a>
      </div>
    </div>
  </section>
</Basis>

<script>
  const knoppen = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const kaarten = Array.from(document.querySelectorAll<HTMLElement>('[data-serre]'));
  const telling = document.querySelector('[data-telling]');

  knoppen.forEach((k) => {
    k.addEventListener('click', () => {
      const keuze = k.dataset.filter;

      knoppen.forEach((b) => {
        const actief = b === k;
        b.setAttribute('aria-pressed', String(actief));
        b.classList.toggle('bg-blad-600', actief);
        b.classList.toggle('text-white', actief);
        b.classList.toggle('bg-staal-100', !actief);
        b.classList.toggle('text-staal-700', !actief);
        b.classList.toggle('hover:bg-staal-200', !actief);
      });

      let zichtbaar = 0;
      kaarten.forEach((kaart) => {
        const tonen = keuze === 'Alles' || kaart.dataset.categorie === keuze;
        kaart.classList.toggle('weg', !tonen);
        if (tonen) zichtbaar++;
      });

      if (telling) {
        telling.textContent = zichtbaar === 1 ? '1 model' : `${zichtbaar} modellen`;
      }
    });
  });
</script>
