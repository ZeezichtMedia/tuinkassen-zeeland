---
import Basis from '../layouts/Basis.astro';
import { Image } from 'astro:assets';
import { bedrijf, accessoires } from '../data/aanbod';
import luchtramen from '../assets/fotos/kas-nokluchting.jpg';
import PaginaKop from '../components/PaginaKop.astro';
import kopfoto from '../assets/fotos/kas-luchtraam-detail.jpg';
---

<Basis
  titel={`Accessoires | ${bedrijf.naam}`}
  omschrijving="Werkbanken, handmatige en automatische raamopeners, funderingen en goten met afvoer. Alles wat je kas af maakt, bij Tuinkassen Zeeland in Ritthem."
>
  <PaginaKop
    label="Accessoires"
    titel="De dingen die je kas af maken"
    tekst="Een kas is meer dan staal en glas. Dit is wat we erbij kunnen doen, meestal meteen bij de bouw, maar later aanbrengen kan ook."
    foto={kopfoto}
    altTekst="Openstaande luchtramen in het dak van een kas, van binnenuit gezien"
  />

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <div class="space-y-10">
          {
            accessoires.map((a, i) => (
              <div class="rijs flex gap-5">
                <span class="font-kop text-3xl font-light text-blad-500 tabular-nums">
                  0{i + 1}
                </span>
                <div class="border-t border-staal-200 pt-3">
                  <h2 class="text-2xl text-staal-900">{a.naam}</h2>
                  <p class="mt-2.5 text-base leading-relaxed text-staal-600">{a.omschrijving}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="rijs lg:sticky lg:top-28 lg:self-start">
          <Image
            src={luchtramen}
            alt="Geopende nokluchting bovenop een tuinkas"
            class="h-72 w-full rounded-2xl object-cover sm:h-[26rem]"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 92vw, 40vw"
          />
          <div class="mt-5 rounded-2xl bg-klei-50 p-6">
            <h2 class="text-xl text-staal-900">Weet je niet wat je nodig hebt?</h2>
            <p class="mt-2.5 text-sm leading-relaxed text-staal-600">
              Dat hoeft ook niet. Bel ons, vertel wat je wilt telen en hoe je tuin ligt, dan zeggen
              wij wel wat zinnig is. Bij funderingen zijn er veel mogelijkheden, die bespreken we
              graag met je.
            </p>
            <a href={`tel:${bedrijf.telefoonNet}`} class="knop-vol mt-5 w-full justify-center">
              Bel {bedrijf.telefoonToon}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-klei-50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="rijs text-3xl text-staal-900 sm:text-4xl">Neem ze meteen mee in je aanvraag</h2>
      <p class="rijs mt-4 text-base leading-relaxed text-staal-600">
        In de configurator vink je aan wat je erbij wilt, dan rekenen we het in één keer voor je
        door.
      </p>
      <a href="/samenstellen/" class="rijs knop-vol mt-7">Stel je kas samen</a>
    </div>
  </section>
</Basis>
