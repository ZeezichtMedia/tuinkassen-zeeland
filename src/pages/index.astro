---
import Basis from '../layouts/Basis.astro';
import { Image } from 'astro:assets';
import { bedrijf, eigenKassen, euroSerres } from '../data/aanbod';
import hero from '../assets/fotos/kas-tuin-zomer.jpg';
import staal from '../assets/fotos/kas-luchtraam-detail.jpg';
import moestuin from '../assets/fotos/kas-tuin-hortensia.jpg';
import zijgevel from '../assets/fotos/kas-najaar-blauwe-lucht.jpg';
import frame from '../assets/fotos/kas-binnen-opbouw.jpg';
import polder from '../assets/fotos/kas-polder-brug.jpg';
import Uitnodiging from '../components/Uitnodiging.astro';
import serreAvond from '../assets/fotos/euroserre-tuin-avond.webp';
import serreMaxi from '../assets/fotos/euroserre-model-maxi.webp';
import serreRustiq from '../assets/fotos/euroserre-model-rustiq.webp';
import serrePlus from '../assets/fotos/euroserre-model-plus.webp';
import serreMuurserre from '../assets/fotos/euroserre-model-muurserre.webp';
import type { ImageMetadata } from 'astro';

const bestsellers = euroSerres.filter((s) => s.bestseller);
const bestsellerFotos: Record<string, ImageMetadata> = {
  'euro-maxi': serreMaxi,
  'euro-rustiq': serreRustiq,
  'euro-plus': serrePlus,
  'euro-muurserre': serreMuurserre,
};

const redenen = [
  {
    kop: 'Staal buigt niet mee',
    tekst:
      'Ons gegalvaniseerde staal is zwaar en stevig. Daardoor heeft de kas geen diagonale verbindingen nodig en blijft hij staan als het hard waait. Dat merk je hier aan de kust.',
  },
  {
    kop: 'Dertig jaar en verder',
    tekst:
      'Het staal is zwaar verzinkt. Een kas gaat er tientallen jaren tegenaan, en dertig jaar is geen uitzondering.',
  },
  {
    kop: 'Glas van tuindersklasse',
    tekst:
      'Vier millimeter tuindersglas, hetzelfde als in de professionele kassenbouw. Het laat veel licht door, is hagelbestendig en blijft goed schoon te maken.',
  },
  {
    kop: 'Recht uit onze eigen loods',
    tekst:
      'We bouwen en plaatsen alles zelf, vanuit onze loods in Ritthem. Geen tussenhandel, dus je krijgt een eerlijke prijs voor een degelijke kas.',
  },
];
---

<Basis
  titel={`${bedrijf.naam} | Stalen tuinkassen en Euroserre serres uit Ritthem`}
  omschrijving="Tuinkassen Zeeland bouwt kassen van zwaar gegalvaniseerd staal en 4 mm tuindersglas, en levert de aluminium serres van Euroserre. Zelf gebouwd en geplaatst vanuit Ritthem."
>
  <!-- Hero -->
  <section class="relative flex h-[100svh] min-h-[600px] items-end overflow-hidden">
    <Image
      src={hero}
      alt="Tuinkas van Tuinkassen Zeeland in een tuin, met openstaande luchtramen"
      class="absolute inset-0 h-full w-full scale-105 object-cover"
      loading="eager"
      fetchpriority="high"
      widths={[800, 1200, 1600, 2048]}
      sizes="100vw"
    />
    {/* Twee lagen: een verloop van onderaf voor de leesbaarheid van de tekst, en
        een zachte vignet zodat de foto naar de randen toe rustig wordt. De
        oude scrim lag als een dichte deken over de hele foto. */}
    <div
      class="absolute inset-0 bg-gradient-to-t from-staal-900 via-staal-900/55 to-staal-900/5"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(120%_85%_at_75%_25%,transparent_35%,rgba(14,26,15,0.45)_100%)]"
    >
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6 sm:pb-24">
      <p class="oogmerk flex items-center gap-2.5 text-white">
        <span class="h-3 w-1 rounded-full bg-blad-400" aria-hidden="true"></span>
        {bedrijf.slogan}
      </p>
      <h1 class="mt-4 max-w-4xl text-[2.6rem] leading-[1.03] text-white sm:text-6xl lg:text-7xl">
        Een kas die blijft staan als het waait
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-staal-100 sm:text-lg">
        Twee lijnen onder één dak: onze eigen kassen van zwaar gegalvaniseerd staal, en de aluminium
        serres van Euroserre in elke kleur die je wilt. Allebei door ons geleverd en geplaatst,
        vanuit Ritthem.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="/kassen/" class="knop-vol justify-center">
          Bekijk onze stalen kassen
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <a href="/euroserre/" class="knop-lijn justify-center">Of de serres van Euroserre</a>
      </div>
    </div>
  </section>

  <!-- Welkom -->
  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="rijs">
          <p class="oogmerk text-blad-600">Welkom bij Tuinkassen Zeeland</p>
          <h2 class="mt-4 text-4xl text-staal-900 sm:text-5xl">
            Wij telen zelf, dus we weten wat een kas moet doen
          </h2>
          <div class="mt-6 space-y-4 text-base leading-relaxed text-staal-600">
            <p>
              {bedrijf.moeder} bouwt en levert tuinkassen. Daarnaast telen we granen, peulvruchten,
              oliehoudende zaden, aardappels, suikerbieten en andere wortel- en knolgewassen. Dat
              land is niet los te zien van de kassen: we weten uit ervaring wat weer en wind hier
              met een constructie doen.
            </p>
            <p>
              We verkopen kwaliteitsproducten en onderscheiden ons met solide materialen en een
              uitstekende klantenservice. Het is niet voor niets dat de meeste van onze klanten
              steeds weer bij ons terugkomen.
            </p>
          </div>
          <a
            href="/contact/"
            class="mt-8 inline-flex items-center gap-2 font-semibold text-blad-700 transition-colors hover:text-blad-800"
          >
            Kom eens langs in Ritthem
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>

        <div class="rijs grid grid-cols-2 gap-4">
          <Image
            src={staal}
            alt="Openstaande luchtramen in het dak van een kas, van binnenuit gezien"
            class="h-56 w-full rounded-2xl object-cover sm:h-72"
            widths={[400, 800]}
            sizes="(max-width: 640px) 45vw, 25vw"
          />
          <Image
            src={moestuin}
            alt="Tuinkas in een tuin, met hortensia's ernaast"
            class="mt-8 h-56 w-full rounded-2xl object-cover sm:h-72"
            widths={[400, 800]}
            sizes="(max-width: 640px) 45vw, 25vw"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Staal of aluminium: de keuze die iedereen hier maakt -->
  <section class="bg-klei-50 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs max-w-2xl">
        <p class="oogmerk text-blad-600">Twee lijnen</p>
        <h2 class="mt-4 text-4xl text-staal-900 sm:text-5xl">Staal van ons, of aluminium van Euroserre</h2>
        <p class="mt-5 text-base leading-relaxed text-staal-600">
          Bijna iedereen die hier binnenloopt staat voor dezelfde keuze. Wij zijn er eerlijk over:
          allebei zijn het goede kassen, ze passen alleen bij een andere wens. Zet ze naast elkaar
          en je ziet meteen wat bij jou hoort.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <article class="rijs flex flex-col overflow-hidden rounded-2xl bg-white shadow-[0_1px_3px_rgba(14,26,15,0.08)]">
          <Image
            src={zijgevel}
            alt="Stalen tuinkas van Tuinkassen Zeeland met openstaande nokluchting"
            class="h-60 w-full object-cover sm:h-72"
            widths={[600, 1200]}
            sizes="(max-width: 1024px) 92vw, 46vw"
          />
          <div class="flex flex-1 flex-col p-7 sm:p-9">
            <p class="oogmerk text-blad-600">Onze eigen bouw</p>
            <h3 class="mt-3 text-3xl text-staal-900">Gegalvaniseerd staal</h3>
            <ul class="mt-6 flex-1 space-y-3 text-base leading-relaxed text-staal-600">
              <li class="flex gap-3">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blad-500" aria-hidden="true"></span>
                <span>Zwaar staal, geen diagonale verbindingen nodig, blijft staan als het waait</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blad-500" aria-hidden="true"></span>
                <span>4 mm tuindersglas, hetzelfde als in de professionele kassenbouw</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blad-500" aria-hidden="true"></span>
                <span>Zelf gemaakt in onze loods, ook in maten die niet in een folder staan</span>
              </li>
            </ul>
            <a
              href="/kassen/"
              class="mt-8 inline-flex items-center gap-2 font-semibold text-blad-700 transition-colors hover:text-blad-800"
            >
              Bekijk onze kassen
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
        </article>

        <article class="rijs flex flex-col overflow-hidden rounded-2xl bg-white shadow-[0_1px_3px_rgba(14,26,15,0.08)]">
          <Image
            src={serreAvond}
            alt="Aluminium serre van Euroserre in een tuin in het avondlicht"
            class="h-60 w-full object-cover sm:h-72"
            widths={[600, 1200]}
            sizes="(max-width: 1024px) 92vw, 46vw"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col p-7 sm:p-9">
            <p class="oogmerk text-blad-600">Wij zijn hun leverancier</p>
            <h3 class="mt-3 text-3xl text-staal-900">Aluminium van Euroserre</h3>
            <ul class="mt-6 flex-1 space-y-3 text-base leading-relaxed text-staal-600">
              <li class="flex gap-3">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blad-500" aria-hidden="true"></span>
                <span>Standaard in zwart of donkergroen in plaats van grijs, elke andere RAL-kleur kan ook</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blad-500" aria-hidden="true"></span>
                <span>Standaard 4 mm veiligheidsglas, breekt in stompe korrels in plaats van scherven</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blad-500" aria-hidden="true"></span>
                <span>Slanke profielen en onderhoudsarm, van 1,6 tot ruim 12 meter breed</span>
              </li>
            </ul>
            <a
              href="/euroserre/"
              class="mt-8 inline-flex items-center gap-2 font-semibold text-blad-700 transition-colors hover:text-blad-800"
            >
              Bekijk de Euroserre serres
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
        </article>
      </div>

      <p class="rijs mt-8 max-w-3xl text-base leading-relaxed text-staal-600">
        Twijfel je nog? Kom een keer langs in Ritthem, dan staan ze naast elkaar en zie je zelf
        wat je mooier vindt. Bellen kan ook, op
        <a href={`tel:${bedrijf.telefoonNet}`} class="font-semibold text-blad-700 hover:text-blad-800">
          {bedrijf.telefoonToon}
        </a>.
      </p>
    </div>
  </section>

  <!-- Waarom staal -->
  <section class="vlak-nacht py-20 text-white sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-2xl rijs">
        <p class="oogmerk text-blad-300">Onze keuze</p>
        <h2 class="mt-4 text-4xl text-white sm:text-5xl">Waarom wij zelf in staal bouwen</h2>
        <p class="mt-5 text-base leading-relaxed text-staal-300">
          Wij maken al onze eigen kassen in staal. Niet uit gewoonte, maar omdat we hier zelf boeren
          en weten wat het weer met een constructie doet.
        </p>
      </div>

      <div class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2">
        {
          redenen.map((r, i) => (
            <div class="rijs flex gap-5">
              <span class="font-kop text-3xl font-light text-blad-400 tabular-nums">
                0{i + 1}
              </span>
              <div class="border-t border-white/15 pt-3">
                <h3 class="text-xl text-white">{r.kop}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-staal-300">{r.tekst}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Maten -->
  <section class="bg-klei-50 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-xl">
          <p class="oogmerk text-blad-600">Onze eigen kassen</p>
          <h2 class="mt-4 text-4xl text-staal-900 sm:text-5xl">Vijf maten om mee te beginnen</h2>
          <p class="mt-5 text-base leading-relaxed text-staal-600">
            Dit zijn de standaardmaten die we kunnen leveren. Zit je maat er niet bij, dan bouwen we
            hem gewoon: rechthoekig, vierkant of rond, in bijna elk formaat dat je wilt.
          </p>
        </div>
        <a href="/kassen/" class="shrink-0 font-semibold text-blad-700 hover:text-blad-800">
          Alle kassen bekijken
        </a>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          eigenKassen.map((k) => (
            <a
              href={`/kassen/#${k.slug}`}
              class="rijs group rounded-2xl bg-white p-6 shadow-[0_1px_3px_rgba(14,26,15,0.08)] transition-shadow hover:shadow-[0_16px_40px_-16px_rgba(14,26,15,0.3)]"
            >
              <h3 class="text-2xl text-staal-900 transition-colors group-hover:text-blad-700">
                {k.naam}
              </h3>
              <p class="mt-1 text-sm text-staal-500">{k.type}</p>
              <dl class="mt-5 flex gap-8 border-t border-staal-200 pt-4 text-sm">
                <div>
                  <dt class="text-staal-500">Breedte</dt>
                  <dd class="mt-0.5 font-semibold text-staal-900">{k.breedte}</dd>
                </div>
                <div>
                  <dt class="text-staal-500">Lengte</dt>
                  <dd class="mt-0.5 font-semibold text-staal-900">{k.lengte}</dd>
                </div>
              </dl>
              <p class="mt-4 text-sm leading-relaxed text-staal-600">{k.omschrijving}</p>
            </a>
          ))
        }

        <a
          href="/contact/"
          class="rijs group flex flex-col justify-between rounded-2xl bg-blad-600 p-6 text-white transition-colors hover:bg-blad-700"
        >
          <div>
            <h3 class="text-2xl text-white">Kom eens langs in Ritthem</h3>
            <p class="mt-4 text-sm leading-relaxed text-blad-50">
              Bel even voordat je komt, dan lopen we samen langs de kassen die hier staan. Zo zie je
              met eigen ogen wat je krijgt, en weet je meteen waar je aan toe bent.
            </p>
          </div>
          <span class="mt-8 inline-flex items-center gap-2 font-semibold">
            Bel of kom langs
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Bestsellers van Euroserre -->
  <section class="bg-white pt-20 sm:pt-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-xl">
          <p class="oogmerk text-blad-600">Bestsellers van Euroserre</p>
          <h2 class="mt-4 text-4xl text-staal-900 sm:text-5xl">De serres die het hardst lopen</h2>
          <p class="mt-5 text-base leading-relaxed text-staal-600">
            Wil je een serre in kleur, met veiligheidsglas erin? Dit zijn de vier modellen die het
            meest gekozen worden. Wij leveren ze en zetten ze ook neer.
          </p>
        </div>
        <a href="/euroserre/" class="shrink-0 font-semibold text-blad-700 hover:text-blad-800">
          Alle serres bekijken
        </a>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          bestsellers.map((b) => (
            <a
              href="/euroserre/"
              class="rijs group overflow-hidden rounded-2xl bg-klei-50 transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-1 hover:shadow-[0_20px_44px_-22px_rgba(14,26,15,0.4)]"
            >
              <Image
                src={bestsellerFotos[b.slug]}
                alt={`De ${b.naam} van Euroserre in een tuin`}
                class="h-44 w-full object-cover"
                widths={[400, 800]}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 23vw"
                loading="lazy"
              />
              <div class="p-5">
                <h3 class="text-2xl text-staal-900 transition-colors group-hover:text-blad-700">
                  {b.naam}
                </h3>
                <p class="mt-2 text-sm text-staal-600">
                  {b.breedte} breed, vanaf {b.minLengte} lang
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Werk -->
  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rijs max-w-xl">
        <p class="oogmerk text-blad-600">Uit onze loods</p>
        <h2 class="mt-4 text-4xl text-staal-900 sm:text-5xl">Zo ziet ons werk eruit</h2>
        <p class="mt-5 text-base leading-relaxed text-staal-600">
          In onze loods in Ritthem zetten we je kas in elkaar. Is hij transportabel, dan komt hij
          compleet aanrijden. Is hij dat niet, dan bouwen we hem bij jou ter plaatse op.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-3">
        <Image
          src={frame}
          alt="Kas in aanbouw, gezien vanuit de binnenkant"
          class="rijs h-64 w-full rounded-2xl object-cover sm:h-80"
          widths={[400, 800]}
          sizes="(max-width: 640px) 92vw, 30vw"
        />
        <Image
          src={zijgevel}
          alt="Geplaatste tuinkas met openstaande nokluchting"
          class="rijs h-64 w-full rounded-2xl object-cover sm:h-80"
          widths={[400, 800]}
          sizes="(max-width: 640px) 92vw, 30vw"
        />
        <Image
          src={polder}
          alt="Tuinkas op een perceel in het Zeeuwse landschap"
          class="rijs h-64 w-full rounded-2xl object-cover sm:h-80"
          widths={[400, 800]}
          sizes="(max-width: 640px) 92vw, 30vw"
        />
      </div>
    </div>
  </section>

  <!-- Slot -->
  <Uitnodiging
    label="Langskomen in Ritthem"
    titel="Sta een keer naast zo'n kas, dan zie je het verschil"
    tekst="Staal voelt anders dan aluminium, dat merk je pas als je ernaast staat. Bel even voor een afspraak, dan staat de loods open en is er iemand voor je."
    foto={polder}
    altTekst="Tuinkas van Tuinkassen Zeeland op een perceel in het Zeeuwse landschap"
    actieHref="/contact/"
    actieTekst="Stuur liever een bericht"
  />
</Basis>
