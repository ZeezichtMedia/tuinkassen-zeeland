---
import Basis from '../layouts/Basis.astro';
import { Image } from 'astro:assets';
import { bedrijf } from '../data/aanbod';
import omgeving from '../assets/fotos/kas-polder-brug.jpg';
import PaginaKop from '../components/PaginaKop.astro';
import kopfoto from '../assets/fotos/kas-tuin-zomer.jpg';
---

<Basis
  titel={`Contact | ${bedrijf.naam}`}
  omschrijving="Neem contact op met Tuinkassen Zeeland in Ritthem. Bel 06 51 32 63 85 of stuur een bericht. Langskomen kan op afspraak."
>
  <PaginaKop
    label="Contact"
    titel="Kom langs en zie het staal van dichtbij"
    tekst="Bellen werkt het snelst. Wil je langskomen, maak dan even een afspraak, dan staat de loods open en is er iemand voor je."
    foto={kopfoto}
    altTekst="Tuinkas van Tuinkassen Zeeland in een tuin, met openstaande luchtramen"
  />

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
        <!-- Gegevens -->
        <div>
          <div class="rijs">
            <h2 class="text-3xl text-staal-900">Direct contact</h2>
            <p class="mt-4 text-base leading-relaxed text-staal-600">
              Vertel wat je van plan bent, dan denken we meteen met je mee over de maat en de plek.
            </p>
            <a
              href={`tel:${bedrijf.telefoonNet}`}
              class="mt-6 flex items-center gap-4 rounded-2xl border border-staal-200 p-5 transition-colors hover:border-blad-300 hover:bg-blad-50"
            >
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-blad-600 text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
                  <path
                    d="M3 5.5A2.5 2.5 0 015.5 3h1.6a1 1 0 01.96.73l.9 3.1a1 1 0 01-.3 1.02l-1.4 1.2a13 13 0 005.7 5.7l1.2-1.4a1 1 0 011.02-.3l3.1.9a1 1 0 01.73.96v1.6a2.5 2.5 0 01-2.5 2.5A15.5 15.5 0 013 5.5z"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <span>
                <span class="block text-xs uppercase tracking-wider text-staal-500">Bel ons</span>
                <span class="block font-kop text-2xl text-staal-900">{bedrijf.telefoonToon}</span>
              </span>
            </a>
          </div>

          <div class="rijs mt-8">
            <h2 class="text-3xl text-staal-900">Waar je ons vindt</h2>
            <address class="mt-4 space-y-0.5 text-base not-italic leading-relaxed text-staal-600">
              <p class="font-semibold text-staal-900">{bedrijf.moeder}</p>
              <p>{bedrijf.straat}</p>
              <p>{bedrijf.postcode} {bedrijf.plaats}</p>
            </address>
            <a
              href="https://www.google.com/maps/search/?api=1&query=Welzingseweg+2A+4389+VH+Ritthem"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 font-semibold text-blad-700 transition-colors hover:text-blad-800"
            >
              Route naar Ritthem
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>

            {/* Bewust geen kaart-embed: OpenStreetMap serveert die tegenwoordig
                via WebGL, en op apparaten zonder WebGL krijg je een blauw
                foutblok in beeld. Dit blijft altijd staan en laat meteen zien
                waar we zitten. */}
            <a
              href="https://www.google.com/maps/search/?api=1&query=Welzingseweg+2A+4389+VH+Ritthem"
              target="_blank"
              rel="noopener"
              class="group relative mt-5 block overflow-hidden rounded-2xl"
            >
              <Image
                src={omgeving}
                alt="Het landschap rond Ritthem, met een kas van Tuinkassen Zeeland"
                class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[600, 1200]}
                sizes="(max-width: 1024px) 92vw, 45vw"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-staal-900 via-staal-900/45 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6">
                <p class="oogmerk text-blad-300">Ritthem, Zeeland</p>
                <p class="mt-2 font-kop text-2xl text-white">Welzingseweg 2A</p>
                <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-white">
                  Open in Google Maps
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                      clip-rule="evenodd"></path>
                  </svg>
                </span>
              </div>
            </a>
          </div>
        </div>

        <!-- Formulier -->
        <div class="rijs rounded-2xl bg-klei-50 p-6 sm:p-8">
          <h2 class="text-3xl text-staal-900">Stuur een bericht</h2>
          <p class="mt-3 text-base leading-relaxed text-staal-600">
            Gebruik dit formulier voor al je vragen of verzoeken. Je krijgt direct een bevestiging
            in je mailbox, en wij reageren meestal binnen een werkdag.
          </p>

          <form class="mt-7 grid gap-4 sm:grid-cols-2" data-formulier novalidate>
            <div>
              <label for="naam" class="text-sm font-semibold text-staal-700">Je naam</label>
              <input id="naam" name="naam" type="text" required class="invoer mt-1.5" autocomplete="name" />
            </div>
            <div>
              <label for="telefoon" class="text-sm font-semibold text-staal-700">Telefoonnummer</label>
              <input id="telefoon" name="telefoon" type="tel" required class="invoer mt-1.5" autocomplete="tel" />
            </div>
            <div class="sm:col-span-2">
              <label for="email" class="text-sm font-semibold text-staal-700">
                E-mailadres <span class="font-normal text-staal-400">Niet verplicht</span>
              </label>
              <input id="email" name="email" type="email" class="invoer mt-1.5" autocomplete="email" />
            </div>
            <div class="sm:col-span-2">
              <label for="onderwerp" class="text-sm font-semibold text-staal-700">Waar gaat het over?</label>
              <select id="onderwerp" name="onderwerp" class="invoer mt-1.5">
                <option>Een stalen kas van Tuinkassen Zeeland</option>
                <option>Een aluminium serre van Euroserre</option>
                <option>Ik weet het nog niet, ik wil me oriënteren</option>
                <option>Reparatie, glasschade of nazorg</option>
                <option>Een afspraak maken om langs te komen</option>
                <option>Iets anders</option>
              </select>
            </div>
            {/* Wim krijgt de maat het liefst meteen mee: mensen bellen toch al
                met "twee bij drie" in hun hoofd. */}
            <div>
              <label for="maat" class="text-sm font-semibold text-staal-700">
                Welke maat heb je ongeveer in gedachten?
                <span class="font-normal text-staal-400">Niet verplicht</span>
              </label>
              <input
                id="maat"
                name="maat"
                type="text"
                class="invoer mt-1.5"
                placeholder="Bijvoorbeeld 3 x 6 meter"
              />
            </div>
            <div>
              <label for="plaats" class="text-sm font-semibold text-staal-700">
                Waar komt de kas te staan? <span class="font-normal text-staal-400">Niet verplicht</span>
              </label>
              <input
                id="plaats"
                name="plaats"
                type="text"
                class="invoer mt-1.5"
                placeholder="Bijvoorbeeld Middelburg"
                autocomplete="address-level2"
              />
            </div>
            <div class="sm:col-span-2">
              <label for="bericht" class="text-sm font-semibold text-staal-700">Je bericht</label>
              <textarea id="bericht" name="bericht" rows="5" required class="invoer mt-1.5"></textarea>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="knop-vol w-full justify-center sm:w-auto">
                Verstuur je bericht
              </button>
            </div>
          </form>

          <div
            class="mt-5 hidden rounded-xl border border-blad-200 bg-blad-50 p-4 text-sm text-blad-800"
            data-melding
            role="status"
          >
          </div>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  .invoer {
    display: block;
    width: 100%;
    border-radius: 0.7rem;
    border: 1.5px solid var(--color-staal-200);
    background: #fff;
    padding: 0.7rem 0.9rem;
    font-size: 0.95rem;
    color: var(--color-staal-900);
    transition: border-color 0.18s ease;
  }
  .invoer:focus {
    border-color: var(--color-blad-600);
    outline: none;
  }
</style>

<script>
  // Demo: het formulier verstuurt nog niets, we bevestigen alleen.
  const formulier = document.querySelector<HTMLFormElement>('[data-formulier]');
  const melding = document.querySelector<HTMLDivElement>('[data-melding]');

  formulier?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!melding) return;

    const naam = (formulier.elements.namedItem('naam') as HTMLInputElement).value.trim();
    const tel = (formulier.elements.namedItem('telefoon') as HTMLInputElement).value.trim();
    const bericht = (formulier.elements.namedItem('bericht') as HTMLTextAreaElement).value.trim();

    if (!naam || !tel || !bericht) {
      melding.classList.remove('hidden', 'border-blad-200', 'bg-blad-50', 'text-blad-800');
      melding.classList.add('border-amber-300', 'bg-amber-50', 'text-amber-900');
      melding.textContent = 'Vul je naam, telefoonnummer en bericht in, dan kunnen we je antwoorden.';
      return;
    }

    melding.classList.remove('hidden', 'border-amber-300', 'bg-amber-50', 'text-amber-900');
    melding.classList.add('border-blad-200', 'bg-blad-50', 'text-blad-800');
    melding.textContent =
      `Bedankt ${naam}, je bericht is binnen. Je krijgt meteen een bevestiging per mail, ` +
      'en wij komen er zo snel mogelijk bij je op terug. ' +
      'Let op: dit is een demo, er wordt nog niets echt verstuurd.';
  });
</script>
