---
import logo from '../assets/logo-tuinkassen-zeeland.png';
import { Image } from 'astro:assets';
import { bedrijf } from '../data/aanbod';

const { pad = '/', startLicht = false } = Astro.props;

/* De lichte staat wordt server-side al gerenderd op pagina's zonder donkere
   hero. Zou het script dat pas na het laden doen, dan zie je de balk omklappen. */
const balkKlassen = startLicht
  ? 'border-staal-200 bg-white/85 shadow-[0_8px_30px_-12px_rgba(14,26,15,0.28)]'
  : 'border-white/10 bg-staal-900/45';

const items = [
  { naam: 'Onze kassen', href: '/kassen/' },
  { naam: 'Euroserre', href: '/euroserre/' },
  { naam: 'Stel samen', href: '/samenstellen/' },
  { naam: 'Accessoires', href: '/accessoires/' },
  { naam: 'Service', href: '/service/' },
  { naam: 'Contact', href: '/contact/' },
];
---

<header
  id="kop"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  data-kop
  data-start-licht={startLicht ? 'ja' : 'nee'}
>
  {/* Smaller dan de inhoudscontainer: er staat weinig in de balk, dus over de
      volle breedte werd het een leeg lint. */}
  <div class="mx-auto max-w-6xl px-4 pt-3 sm:px-6 sm:pt-4">
    <div
      class:list={[
        'flex items-center justify-between gap-3 rounded-full border px-3 py-2 backdrop-blur-xl transition-colors duration-300 sm:px-4',
        balkKlassen,
      ]}
      data-balk
    >
      <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Naar de homepagina van Tuinkassen Zeeland">
        <Image
          src={logo}
          alt="Tuinkassen Zeeland"
          width={132}
          height={101}
          class="h-9 w-auto rounded-md sm:h-10"
          loading="eager"
        />
        <span class="sr-only">{bedrijf.naam}</span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Hoofdmenu">
        {items.map((i) => (
          <a
            href={i.href}
            class:list={[
              'whitespace-nowrap rounded-full px-3 py-2.5 text-[1rem] font-semibold transition-colors',
              pad === i.href
                ? startLicht
                  ? 'bg-blad-50 text-blad-700'
                  : 'bg-white/95 text-blad-700'
                : startLicht
                  ? 'text-staal-700 hover:bg-staal-100 hover:text-blad-700'
                  : 'text-white/90 hover:bg-white/12 hover:text-white',
            ]}
            data-link
          >
            {i.naam}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={`tel:${bedrijf.telefoonNet}`}
          class="hidden whitespace-nowrap rounded-full bg-blad-600 px-4 py-2.5 text-[1rem] font-semibold text-white transition-colors hover:bg-blad-700 sm:inline-flex"
        >
          Bel {bedrijf.telefoonToon}
        </a>
        <button
          type="button"
          class:list={[
            'grid h-10 w-10 place-items-center rounded-full border transition-colors lg:hidden',
            startLicht
              ? 'border-staal-300 text-staal-800 hover:bg-staal-100'
              : 'border-white/20 text-white hover:bg-white/12',
          ]}
          aria-label="Menu openen"
          aria-expanded="false"
          aria-controls="mobielmenu"
          data-menuknop
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" data-streep />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobiel menu -->
<div
  id="mobielmenu"
  class="fixed inset-0 z-40 hidden bg-staal-900/95 backdrop-blur-xl lg:hidden"
  data-mobielmenu
>
  <nav class="flex h-full flex-col justify-center gap-1 px-6 pt-16" aria-label="Mobiel menu">
    {items.map((i) => (
      <a
        href={i.href}
        class:list={[
          'border-b border-white/10 py-4 font-kop text-2xl font-medium transition-colors',
          pad === i.href ? 'text-blad-300' : 'text-white hover:text-blad-300',
        ]}
      >
        {i.naam}
      </a>
    ))}
    <a href={`tel:${bedrijf.telefoonNet}`} class="knop-vol mt-8 justify-center">
      Bel {bedrijf.telefoonToon}
    </a>
  </nav>
</div>

<script>
  const balk = document.querySelector('[data-balk]') as HTMLElement | null;
  const knop = document.querySelector('[data-menuknop]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobielmenu]') as HTMLElement | null;

  // Header wordt wit zodra je van de hero af scrollt.
  const licht = [
    'bg-white/85',
    'border-staal-200',
    'shadow-[0_8px_30px_-12px_rgba(14,26,15,0.28)]',
  ];

  // Pagina's zonder donkere hero staan altijd in de lichte staat.
  const altijdLicht =
    document.querySelector('[data-kop]')?.getAttribute('data-start-licht') === 'ja';

  function bijScroll() {
    if (!balk) return;
    const ver = altijdLicht || window.scrollY > 40;
    balk.classList.toggle('bg-staal-900/45', !ver);
    balk.classList.toggle('border-white/10', !ver);
    licht.forEach((c) => balk.classList.toggle(c, ver));
    document.querySelectorAll('[data-link]').forEach((el) => {
      const a = el as HTMLElement;
      const actief = a.classList.contains('bg-white/95') || a.classList.contains('bg-blad-50');
      if (actief) {
        a.classList.toggle('bg-white/95', !ver);
        a.classList.toggle('bg-blad-50', ver);
        return;
      }
      a.classList.toggle('text-white/90', !ver);
      a.classList.toggle('hover:bg-white/12', !ver);
      a.classList.toggle('hover:text-white', !ver);
      a.classList.toggle('text-staal-700', ver);
      a.classList.toggle('hover:bg-staal-100', ver);
      a.classList.toggle('hover:text-blad-700', ver);
    });
    if (knop) {
      knop.classList.toggle('text-white', !ver);
      knop.classList.toggle('border-white/20', !ver);
      knop.classList.toggle('hover:bg-white/12', !ver);
      knop.classList.toggle('text-staal-800', ver);
      knop.classList.toggle('border-staal-300', ver);
      knop.classList.toggle('hover:bg-staal-100', ver);
    }
  }

  window.addEventListener('scroll', bijScroll, { passive: true });
  bijScroll();

  knop?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    knop.setAttribute('aria-expanded', String(open));
    knop.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    document.body.style.overflow = open ? 'hidden' : '';
    const streep = knop.querySelector('[data-streep]');
    streep?.setAttribute('d', open ? 'M6 6l12 12M18 6L6 18' : 'M4 7h16M4 12h16M4 17h16');
    if (open) {
      knop.classList.add('text-white', 'border-white/20');
      knop.classList.remove('text-staal-800', 'border-staal-300');
    } else {
      bijScroll();
    }
  });
</script>
