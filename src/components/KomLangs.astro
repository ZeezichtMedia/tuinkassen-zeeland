---
import { Image } from 'astro:assets';
import { bedrijf } from '../data/aanbod';
import sfeer from '../assets/fotos/kassen/venlo-340x585-dubbele-deur-voorkant.webp';

/**
 * De uitnodiging om langs te komen. Dit is waar het Wim om gaat: mensen
 * moeten niet via de site bestellen, maar bellen en in Ritthem komen kijken.
 * Daarom staat dit blok onderaan elke pagina, en zegt het precies wat je er
 * aantreft en hoe je het regelt.
 */
interface Props {
  titel?: string;
}
const { titel = 'Kom kijken in Ritthem' } = Astro.props;

const route = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${bedrijf.straat} ${bedrijf.postcode} ${bedrijf.plaats}`
)}`;

const watJeZiet = [
  'Kassen die klaar staan, zodat je er echt in kunt lopen',
  'Het staal en het glas van dichtbij, in je eigen handen',
  'Iemand die meedenkt over de maat en de plek in je tuin',
];
---

<section id="langskomen" class="scroll-mt-24 bg-klei-50 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="rijs overflow-hidden rounded-[1.75rem] bg-white shadow-[0_30px_80px_-50px_rgba(14,26,15,0.45)]">
      <div class="grid lg:grid-cols-[1.05fr_1fr]">
        <div class="relative min-h-[18rem] lg:min-h-full">
          <Image
            src={sfeer}
            alt="Een Venlo kas van Tuinkassen Zeeland met de deuren open en een Zeeuwse akker erachter"
            class="absolute inset-0 h-full w-full object-cover"
            widths={[600, 1000, 1400]}
            sizes="(max-width: 1024px) 100vw, 52vw"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-staal-900/80 via-staal-900/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6 sm:p-8">
            <p class="oogmerk text-blad-200">Ons adres</p>
            <p class="mt-2 font-kop text-2xl text-white sm:text-3xl">{bedrijf.straat}</p>
            <p class="text-staal-200">{bedrijf.postcode} {bedrijf.plaats}</p>
          </div>
        </div>

        <div class="p-7 sm:p-10 lg:p-12">
          <p class="oogmerk flex items-center gap-2.5 text-blad-700">
            <span class="h-3 w-1 rounded-full bg-blad-600" aria-hidden="true"></span>
            Langskomen
          </p>
          <h2 class="mt-5 text-4xl leading-[1.05] text-staal-900 sm:text-5xl">{titel}</h2>
          <p class="mt-5 text-base leading-relaxed text-staal-600 sm:text-lg">
            Een kas koop je niet van een plaatje. Kom een keer langs, dan loop je er samen met ons
            doorheen en zie je meteen wat bij jouw tuin past.
          </p>

          <ul class="mt-7 space-y-3.5">
            {
              watJeZiet.map((regel) => (
                <li class="flex gap-3 text-base text-staal-700">
                  <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-blad-600" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{regel}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 rounded-2xl bg-blad-50 p-5 text-sm leading-relaxed text-blad-900">
            <span class="font-semibold">Bel even voordat je komt.</span> Dan weet je zeker dat de loods
            open is en er iemand voor je klaarstaat.
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={`tel:${bedrijf.telefoonNet}`} class="knop-vol justify-center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                <path
                  d="M3 5.5A2.5 2.5 0 015.5 3h1.6a1 1 0 01.96.73l.9 3.1a1 1 0 01-.3 1.02l-1.4 1.2a13 13 0 005.7 5.7l1.2-1.4a1 1 0 011.02-.3l3.1.9a1 1 0 01.73.96v1.6a2.5 2.5 0 01-2.5 2.5A15.5 15.5 0 013 5.5z"
                  stroke-linejoin="round"></path>
              </svg>
              Bel {bedrijf.telefoonToon}
            </a>
            <a
              href={route}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-staal-300 px-6 py-3.5 font-semibold text-staal-800 transition-colors hover:border-staal-400 hover:bg-staal-50"
            >
              Plan je route
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
